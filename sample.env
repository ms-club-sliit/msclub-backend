# ==============================
# ⚙️  App Configuration
# ==============================
NODE_ENV=Development
PORT=8087
IP=0.0.0.0

# ==============================
# 🗃️ MongoDB
# ==============================
MONGO_URI=<YOUR_MONGO_URI>

# ==============================
# 🔐 JWT Configuration
# ==============================
JWT_SECRET=yourSuperSecretKey

# ==============================
# 📧 Email Configuration
# ==============================
EMAIL_HOST=<YOUR_EMAIL_HOST>
EMAIL_PORT=587
EMAIL_AUTH_USER=<YOUR_EMAIL_AUTH_USER>
EMAIL_AUTH_PASSWORD=<YOUR_EMAIL_AUTH_PASSWORD>




# ==============================
# Supabase Configuration
# ==============================
SUPABASE_URL=<YOUR_SUPABASE_URL>
SUPABASE_ANON_KEY=<YOUR_SUPABASE_ANON_KEY>
SUPABASE_SERVICE_ROLE_KEY=<YOUR_SUPABASE_SERVICE_ROLE_KEY>


# ==============================
# Supabase Storage Buckets
# ==============================
APPLICATION_IMAGES_BUCKET=application-images
EMAIL_TEMPLATE_BUCKET=email-templates

# ==============================
# Message Broker (CloudAMQP)
# ==============================
MESSAGE_BROKER_URL=<YOUR_MESSAGE_BROKER_URL>

# (separate creds if you ever need them)
CLOUDAMQP_USERNAME=<YOUR_CLOUDAMQP_USERNAME>
CLOUDAMQP_PASSWORD=<YOUR_CLOUDAMQP_PASSWORD>

# ==============================
# Queue Names
# ==============================
EXCHANGE_NAME=msclub_exchange
EMAIL_SERVICE_NAME=email_service
EMAIL_QUEUE_NAME=email_queue

# ==============================
# Additional Services
# ==============================
MS_MEETING_MANAGER_API=your_meeting_manager_api_url

# ==============================
# Face API Configuration
# ==============================
FACE_API_ENABLED=true/false
FACE_API_KEY=your_face_api_key
FACE_API_HOST=your_face_api_host
FACE_API_STORAGE_BUCKET_URL=your_face_api_storage_bucket_url
FACE_API_LARGE_LIST=your_face_api_large_list